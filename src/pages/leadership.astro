---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { ciren, roles } from '../data/leadership';
---

<Base title="Leadership">
  <PageHero
    title="My leadership"
    lead="I build rooms where other people start building."
    body="Hackathons, clubs, journal clubs and workshops. The goal is the same each time: put research and real tools in front of students who would otherwise wait years for the chance."
    shapes={[
      { type: 'circle', top: '16%', left: '3.7%', size: 22 },
      { type: 'line', top: '26%', left: '43.5%', size: 180, angle: -30, desktop: true },
      { type: 'circle', top: '21%', left: '79.5%', size: 150, desktop: true },
      { type: 'circle', top: '40%', left: '71%', size: 100, desktop: true },
      { type: 'circle', top: '54%', left: '88%', size: 72, desktop: true },
    ]}
  />

  <section class="section bg-dark on-dark ciren">
    <div class="container">
      <div class="ciren__grid">
        <div>
          <p class="eyebrow ciren__meta">{ciren.meta}</p>
          <h2 class="ciren__name">{ciren.name}</h2>
          <p class="ciren__full">{ciren.full}</p>
          <p class="ciren__body">{ciren.body}</p>
        </div>
        <dl class="ciren__stats">
          {
            ciren.stats.map((s) => (
              <div class="ciren__stat">
                <dt class="ciren__value">{s.value}</dt>
                <dd class="eyebrow ciren__label">{s.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="partners">
        <p class="eyebrow partners__label">Partners</p>
        <ul class="partners__list">
          {ciren.partners.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head">
        <div>
          <h2 class="h-section">Other roles</h2>
          <p class="sub">On campus and beyond it.</p>
        </div>
      </header>

      <div class="roles">
        {
          roles.map((r) => (
            <article class="role">
              <p class="eyebrow role__org">{r.org}</p>
              <h3 class="role__title">{r.title}</h3>
              <p class="body role__body">{r.body}</p>
              <ul class="role__stats">
                {r.stats.map((s) => (
                  <li>
                    <strong>{s.value}</strong> {s.label}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* CIReN */
  .ciren__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .ciren__meta {
    color: var(--on-dark-muted);
    font-size: 10px;
  }

  .ciren__name {
    margin-top: 14px;
    font-size: clamp(56px, 6vw, 84px);
    font-weight: 800;
    line-height: 1;
  }

  .ciren__full {
    margin-top: 18px;
    font-family: var(--font-light);
    font-weight: 300;
    font-size: clamp(20px, 1.7vw, 24px);
  }

  .ciren__body {
    margin-top: 18px;
    color: var(--on-dark-muted);
    font-size: 14px;
    line-height: 1.8;
  }

  .ciren__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border: 1px solid var(--dark-line);
  }

  .ciren__stat {
    padding: 30px clamp(18px, 2vw, 30px);
    border-right: 1px solid var(--dark-line);
    border-bottom: 1px solid var(--dark-line);
  }

  .ciren__stat:nth-child(2n) {
    border-right: 0;
  }

  .ciren__stat:nth-last-child(-n + 2) {
    border-bottom: 0;
  }

  .ciren__value {
    font-size: clamp(36px, 3.2vw, 48px);
    font-weight: 800;
    line-height: 1;
  }

  .ciren__label {
    margin: 12px 0 0;
    color: var(--on-dark-muted);
    font-size: 10px;
  }

  .partners {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px clamp(24px, 3vw, 44px);
    margin-top: clamp(40px, 4vw, 60px);
    padding-top: 32px;
    border-top: 1px solid var(--dark-line);
  }

  .partners__label {
    color: var(--on-dark-muted);
    font-size: 10px;
  }

  .partners__list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px clamp(24px, 2.6vw, 40px);
  }

  .partners__list li {
    font-size: clamp(14px, 1.2vw, 17px);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Other roles */
  .roles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .role {
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.8vw, 40px);
    border: 1px solid var(--border);
  }

  .role__org {
    color: var(--muted);
    font-size: 10px;
  }

  .role__title {
    margin-top: 10px;
    font-size: clamp(17px, 1.5vw, 21px);
    font-weight: 800;
    text-transform: uppercase;
  }

  .role__body {
    margin-top: 12px;
    font-size: 14px;
  }

  .role__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    font-size: 12px;
  }

  .role__body + .role__stats {
    margin-top: 16px;
  }

  .role__stats strong {
    font-size: 15px;
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .ciren__grid,
    .roles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
