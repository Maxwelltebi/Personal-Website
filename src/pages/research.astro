---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { areas, papers } from '../data/research';

const statusClass = {
  solid: 'tag--solid',
  outline: '',
  soft: 'tag--soft',
  dashed: 'tag--dashed',
} as const;
---

<Base title="Research">
  <PageHero
    title="My research"
    lead="I research to discover what's true, then test whether it holds."
    body="Applied machine learning and statistics, aimed at problems in healthcare, finance and climate risk. Most of it starts close to home."
    shapes={[
      { type: 'circle', top: '9%', left: '4%', size: 64 },
      { type: 'circle', top: '24%', left: '67.5%', size: 22, desktop: true },
      { type: 'circle', top: '24%', left: '68.5%', size: 240, desktop: true },
      { type: 'circle', top: '45%', left: '74.5%', size: 240, desktop: true },
      { type: 'line', top: '88%', left: '37.5%', size: 270, angle: -30, desktop: true },
    ]}
  />

  <section class="bg-dark on-dark">
    <div class="container areas">
      {
        areas.map((a) => (
          <article class="area">
            <p class="eyebrow area__num">{a.num}</p>
            <h2 class="area__title">{a.title}</h2>
            <p class="area__body">{a.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-head">
        <div>
          <h2 class="h-section">Projects &amp; papers</h2>
          <p class="sub">Finished, running, and proposed.</p>
        </div>
      </header>

      <ol class="rule-list">
        {
          papers.map((p) => (
            <li class="paper" id={p.id}>
              <div class="paper__when">
                <p class="paper__year">{p.year}</p>
                <p class="paper__where">{p.where}</p>
                <span class:list={['tag', statusClass[p.status.style]]}>{p.status.label}</span>
              </div>
              <div>
                <h3 class="paper__title">{p.title}</h3>
                <p class="body paper__body">{p.body}</p>
                <p class="stack stack--caps paper__stack">{p.stack.join(' · ')}</p>
                {p.links.length > 0 && (
                  <div class="paper__links">
                    {p.links.map((l) => (
                      <a class="link-u" href={l.href}>
                        {l.label} {l.arrow}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  /* Research areas */
  .areas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .area {
    padding: 48px clamp(24px, 3vw, 40px) 52px;
    border-left: 1px solid var(--dark-line);
    transition: background 0.4s;
  }

  .area__num,
  .area__body {
    transition: color 0.4s;
  }

  .area:hover {
    background: #1b1b1b;
  }

  .area:hover .area__num,
  .area:hover .area__body {
    color: var(--white);
  }

  .area:first-child {
    border-left: 0;
  }

  .area__num {
    color: var(--on-dark-muted);
    font-size: 10px;
  }

  .area__title {
    margin-top: 10px;
    font-size: clamp(19px, 1.5vw, 21px);
    font-weight: 800;
    text-transform: uppercase;
  }

  .area__body {
    margin-top: 12px;
    color: var(--on-dark-muted);
    font-family: var(--font-light);
    font-size: 17px;
    line-height: 1.6;
  }

  /* Projects & papers */
  .paper {
    display: grid;
    grid-template-columns: minmax(180px, 0.3fr) minmax(0, 1fr);
    gap: 32px;
    padding: 36px 0 52px;
    scroll-margin-top: 24px;
  }

  .paper__when {
    padding-left: 12px;
  }

  .paper__year {
    font-size: clamp(24px, 2vw, 29px);
    font-weight: 800;
    line-height: 1.2;
  }

  .paper__where {
    margin: 4px 0 10px;
    max-width: 200px;
    color: var(--muted);
    font-size: 11px;
  }

  .paper__title {
    font-size: clamp(19px, 1.7vw, 24px);
    font-weight: 800;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .paper__body {
    margin-top: 12px;
    font-size: 14px;
  }

  .paper__stack {
    margin-top: 12px;
    font-size: 10px;
  }

  .paper__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 24px;
  }

  .paper__links .link-u {
    font-size: 10px;
  }

  @media (max-width: 860px) {
    .areas {
      grid-template-columns: minmax(0, 1fr);
    }

    .area {
      border-left: 0;
      border-top: 1px solid var(--dark-line);
      padding-inline: 0;
    }

    .area:first-child {
      border-top: 0;
    }
  }

  @media (max-width: 760px) {
    .paper {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding: 32px 0 40px;
    }

    .paper__when {
      padding-left: 0;
    }
  }
</style>
