---
import { href, type Project } from '../lib/content';

interface Props {
  build: Project;
}

const { build } = Astro.props;
---

<article class="card" data-categories={build.categories.join('|')}>
  {
    build.screenshot ? (
      <img class="card__shot" src={build.screenshot} alt={`${build.title} screenshot`} loading="lazy" />
    ) : (
      <div class="placeholder card__shot">[Add screenshot]</div>
    )
  }
  <div class="card__body">
    {build.badge && <span class="tag card__badge">{build.badge}</span>}
    <h3 class="card__title">{build.title}</h3>
    <p class="card__text">{build.summary}</p>
    <p class="stack card__stack">{build.stack}</p>
    <div class="card__links">
      <a class="link-u" href={href(build.codeUrl)}>Code ↗</a>
      <a class="link-u" href={`/innovations/${build.slug}`}>Case study ↗</a>
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--white);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s, box-shadow 0.5s;
  }

  .card__shot {
    width: 100%;
    height: 190px;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .card:hover {
      transform: translateY(-6px);
      border-color: var(--black);
      box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.35);
    }

    .card:hover .card__shot {
      transform: scale(1.04);
    }
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 26px 28px 30px;
  }

  .card__badge {
    align-self: flex-start;
    padding: 4px 8px;
    font-size: 9px;
  }

  .card__title {
    margin-top: 12px;
    font-size: 19px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .card__text {
    margin-top: 10px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }

  .card__stack {
    margin-top: 14px;
    font-size: 10px;
    letter-spacing: 0.02em;
  }

  .card__links {
    display: flex;
    gap: 22px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }

  .card__stack + .card__links {
    margin-top: 16px;
  }

  .card__links .link-u {
    font-size: 10px;
  }
</style>
