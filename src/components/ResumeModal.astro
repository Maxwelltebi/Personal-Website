---
import { site } from '../data/site';
import Icon from './Icon.astro';

const { href, file, pages } = site.resume;
---

<dialog class="resume" id="resume-modal" aria-labelledby="resume-title" data-src={href}>
  <div class="resume__panel" tabindex="-1" autofocus>
    <header class="resume__head">
      <div>
        <h2 class="resume__title" id="resume-title">Résumé</h2>
        <p class="resume__file">{file} · {pages} page</p>
      </div>
      <div class="resume__actions">
        <a class="btn btn--solid" href={href} download={file}>Download</a>
        <a class="btn" href={href} target="_blank" rel="noopener">Open</a>
        <button class="resume__close" type="button" data-resume-close aria-label="Close résumé">
          <Icon name="close" size={24} />
        </button>
      </div>
    </header>

    <div class="resume__body">
      <div class="resume__pages" data-pages aria-label="Résumé preview"></div>
      <div class="resume__fallback placeholder" data-fallback hidden>
        <p>The preview couldn't load</p>
        <a class="btn btn--solid" href={href} target="_blank" rel="noopener">Open résumé</a>
      </div>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('resume-modal') as HTMLDialogElement | null;
  const pagesEl = dialog?.querySelector<HTMLElement>('[data-pages]');
  const fallback = dialog?.querySelector<HTMLElement>('[data-fallback]');
  let rendered: Promise<void> | null = null;

  // Draws each PDF page to a canvas, so the preview looks the same in every browser,
  // phones included. pdf.js is only downloaded the first time the résumé is opened.
  async function renderPdf() {
    if (!dialog || !pagesEl) return;
    // Reset in case an earlier attempt failed and this is a retry.
    pagesEl.replaceChildren();
    pagesEl.hidden = false;
    if (fallback) fallback.hidden = true;
    try {
      const pdfjs = await import('pdfjs-dist');
      const worker = await import('pdfjs-dist/build/pdf.worker.min.mjs?url');
      pdfjs.GlobalWorkerOptions.workerSrc = worker.default;

      const pdf = await pdfjs.getDocument({ url: dialog.dataset.src!, disableFontFace: true }).promise;
      const width = pagesEl.clientWidth;
      const ratio = Math.min(window.devicePixelRatio || 1, 2);

      for (let n = 1; n <= pdf.numPages; n++) {
        const page = await pdf.getPage(n);
        const base = page.getViewport({ scale: 1 });
        const viewport = page.getViewport({ scale: (width / base.width) * ratio });
        const canvas = document.createElement('canvas');
        canvas.className = 'resume__page';
        canvas.width = viewport.width;
        canvas.height = viewport.height;
        canvas.setAttribute('role', 'img');
        canvas.setAttribute('aria-label', `Résumé page ${n}`);
        pagesEl.append(canvas);
        await page.render({ canvas, viewport }).promise;
      }
      pagesEl.dataset.ready = 'true';
    } catch (err) {
      console.error(err);
      rendered = null;
      pagesEl.hidden = true;
      if (fallback) fallback.hidden = false;
    }
  }

  const open = () => {
    if (!dialog) return;
    dialog.showModal();
    document.body.classList.add('modal-open');
    rendered ??= renderPdf();
  };

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest('[data-resume-open]');
    if (!trigger || !dialog) return;
    e.preventDefault();
    open();
  });

  dialog?.querySelector('[data-resume-close]')?.addEventListener('click', () => dialog.close());
  // Clicking the dimmed backdrop (the dialog element itself) closes it.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => {
    document.body.classList.remove('modal-open');
    if (location.hash === '#resume') history.replaceState(null, '', location.pathname + location.search);
  });

  // Shareable link: any page + #resume opens the résumé.
  if (location.hash === '#resume') open();
</script>

<style>
  .resume {
    width: min(100% - 32px, 1250px);
    max-width: none;
    height: min(100dvh - 64px, 1350px);
    max-height: none;
    padding: 0;
    border: 0;
    background: var(--white);
    color: var(--text);
  }

  .resume::backdrop {
    background: rgba(17, 17, 17, 0.72);
  }

  :global(html.motion) .resume[open] {
    animation: resume-in 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(html.motion) .resume[open]::backdrop {
    animation: resume-fade 0.4s ease-out;
  }

  @keyframes resume-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.97);
    }
  }

  @keyframes resume-fade {
    from {
      opacity: 0;
    }
  }

  .resume__panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    outline: none;
  }

  .resume__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 28px;
    border-bottom: 1px solid var(--border);
  }

  .resume__title {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .resume__file {
    color: var(--muted);
    font-size: 14px;
  }

  .resume__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .resume__close {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-left: 12px;
    border: 0;
    background: transparent;
  }

  .resume__close:hover {
    opacity: 0.6;
  }

  .resume__body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 28px;
    background: var(--grey-2);
  }

  .resume__pages {
    display: grid;
    gap: 20px;
    min-height: 100%;
  }

  .resume__pages :global(.resume__page) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--white);
    box-shadow: 0 2px 14px rgba(0, 0, 0, 0.08);
  }

  .resume__fallback {
    display: grid;
    height: 100%;
    gap: 20px;
    align-content: center;
    padding: 24px;
    text-align: center;
  }

  @media (max-width: 720px) {
    .resume {
      width: calc(100% - 24px);
      height: calc(100dvh - 24px);
    }

    .resume__head {
      position: relative;
      flex-direction: column;
      align-items: stretch;
      padding: 18px 16px;
    }

    .resume__actions .btn {
      flex: 1;
    }

    .resume__close {
      position: absolute;
      top: 10px;
      right: 8px;
    }

    .resume__body {
      padding: 12px;
    }
  }

  :global(body.modal-open) {
    overflow: hidden;
  }
</style>
