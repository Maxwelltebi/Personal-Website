---
import Shapes, { type Shape } from './Shapes.astro';

interface Props {
  title: string;
  lead?: string;
  body?: string | readonly string[];
  shapes?: Shape[];
  /** Show the headshot on the right, sitting on the bottom edge of the hero. */
  photo?: boolean;
  size?: 'xl' | 'lg';
}

const { title, lead, body, shapes = [], photo = false, size = 'lg' } = Astro.props;
const paragraphs = (Array.isArray(body) ? body : [body]).filter((p): p is string => !!p?.trim());
// Each title line sits in its own mask so the entrance can slide it up from behind the edge.
const lines = title
  .split(/\r?\n|<br\s*\/?>/i)
  .map((l) => l.trim())
  .filter(Boolean);
---

<section class:list={['hero', 'bg-grey', { 'hero--photo': photo }]}>
  <Shapes shapes={shapes} />
  <div class="container hero__inner">
    <div class="hero__text">
      {Astro.slots.has('kicker') && <div data-hero-item><slot name="kicker" /></div>}
      <h1 class:list={['display', `hero__title--${size}`]} data-hero-title>
        {lines.map((l) => <span class="line"><span class="line__inner" set:html={l} /></span>)}
      </h1>
      {lead && <p class="lead hero__lead" data-hero-item>{lead}</p>}
      {paragraphs.map((p) => <p class="body hero__body" data-hero-item>{p}</p>)}
      {Astro.slots.has('default') && <div data-hero-item><slot /></div>}
    </div>
    {
      photo && (
        <div class="hero__photo" data-hero-photo>
          <span class="hero__halo" data-photo-halo aria-hidden="true" />
          <img
            data-photo-img
            src="/images/headshot.webp"
            alt="Portrait of Maxwell Tebi"
            width="1240"
            height="1240"
            fetchpriority="high"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: clamp(56px, 6.5vw, 96px) clamp(64px, 6.5vw, 96px);
  }

  .hero__text {
    position: relative;
    max-width: 760px;
  }

  .line {
    display: block;
    overflow: hidden;
    /* Room for commas and descenders inside the mask. */
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .line__inner {
    display: block;
  }

  .hero__title--xl {
    font-size: clamp(46px, 5.6vw, 82px);
  }

  .hero__title--lg {
    font-size: clamp(44px, 5.6vw, 82px);
  }

  .hero__lead {
    margin-top: 18px;
    max-width: 700px;
  }

  .hero__body {
    margin-top: 22px;
    max-width: 560px;
  }

  .hero__body + .hero__body {
    margin-top: 16px;
  }

  /* With photo: two columns, picture anchored to the bottom edge. */
  .hero--photo .hero__inner {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 40px;
    padding-bottom: 0;
  }

  .hero--photo .hero__text {
    padding-bottom: clamp(56px, 6.5vw, 96px);
    align-self: center;
  }

  .hero__photo {
    position: relative;
    align-self: end;
    justify-self: end;
    width: min(100%, 620px);
    perspective: 1400px;
  }

  .hero__photo img {
    position: relative;
    width: 100%;
    height: auto;
    /* Hinged at the bottom edge so tilting keeps the photo anchored to the hero. */
    transform-origin: 50% 100%;
  }

  /* Outline circle behind the head; appears and follows the cursor on hover (see motion.ts). */
  .hero__halo {
    position: absolute;
    top: 6%;
    left: 50%;
    width: 64%;
    aspect-ratio: 1;
    margin-left: -32%;
    border: 1.5px solid var(--line);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .hero--photo .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .hero--photo .hero__text {
      padding-bottom: 40px;
    }

    .hero__photo {
      justify-self: center;
      width: min(100%, 420px);
    }
  }
</style>
