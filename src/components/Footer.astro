---
import { site } from '../data/site';
import Shapes from './Shapes.astro';
---

<footer class="cta bg-dark on-dark">
  <Shapes
    tone="dark"
    shapes={[
      { type: 'circle', top: '9%', right: '8%', size: 64 },
      { type: 'circle', top: '74%', left: '55%', size: 14, desktop: true },
    ]}
  />
  <div class="container cta__inner">
    <h2 class="cta__title">Let's work together</h2>
    <p class="cta__sub">Research collaborations, internships, or a product worth building.</p>
    <a class="btn btn--white cta__email" href={`mailto:${site.email}`}>{site.email}</a>

    <div class="cta__foot">
      <p>© 2026 {site.name} · {site.location}</p>
      <div class="cta__links">
        <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={site.github} target="_blank" rel="noopener">GitHub</a>
        <a class="cta__resume" href={site.resume.href} data-resume-open>Résumé</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .cta {
    position: relative;
    padding-top: clamp(72px, 8vw, 100px);
    padding-bottom: 32px;
  }

  .cta__inner {
    position: relative;
  }

  .cta__title {
    font-size: clamp(38px, 6vw, 80px);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .cta__sub {
    margin-top: 18px;
    color: var(--on-dark-muted);
    font-family: var(--font-light);
    font-weight: 300;
    font-size: clamp(17px, 1.6vw, 23px);
  }

  .cta__email {
    margin-top: 40px;
    min-height: 50px;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cta__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: clamp(56px, 6vw, 80px);
    padding-top: 28px;
    border-top: 1px solid var(--dark-line);
    color: var(--on-dark-muted);
    font-size: 12px;
  }

  .cta__links {
    display: flex;
    gap: 24px;
  }

  .cta__links a {
    color: var(--white);
    font-size: 12px;
    font-weight: 700;
    text-underline-offset: 3px;
  }

  .cta__links a.cta__resume {
    text-decoration: none;
  }

  .cta__links a:hover {
    opacity: 0.7;
  }

  @media (max-width: 480px) {
    .cta__email {
      padding-inline: 16px;
      letter-spacing: 0.08em;
    }
  }
</style>
